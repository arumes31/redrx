# Core Configuration
# SECRET_KEY has no default and must be set explicitly. Left commented on
# purpose: copying this file must NOT hand you a working placeholder secret —
# generate your own, e.g.  SECRET_KEY=$(openssl rand -hex 32)
# SECRET_KEY=
# DATABASE_URL=sqlite:///db/shortener.db

# Server
LISTEN_ADDR=:5000
# REDRX_DEBUG=false

# App Settings
BASE_DOMAIN=short.example.com
SHORT_CODE_LENGTH=6
EXPIRY_HOURS=24

# QR Code Styling
DEFAULT_QR_COLOR=black
DEFAULT_QR_BACKGROUND=white

# Safety
BLOCKED_DOMAINS=example-malware.com,test-phish.net
RATELIMIT_STORAGE_URL=redis://redis:6379
RATELIMIT_DEFAULT="200 per day;50 per hour"
RATELIMIT_CREATE="10 per minute"
RATELIMIT_REDIRECT="100 per minute"
DISABLE_ANONYMOUS_CREATE=false
DISABLE_REGISTRATION=false
ANONYMIZE_LOGS=false
ENABLE_SEO=false
SEO_DOMAIN=redrx.eu

# Phishing Protection
ENABLE_PHISHING_CHECK=true
PHISHING_CHECK_INTERVAL=24
ENABLE_AUTO_REMOVE_PHISHING=false
PHISHING_REMOVE_INTERVAL=24
PHISHING_LIST_URLS=https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt
BLOCKED_DOMAINS_PATH=/app/data/blocked_domains.txt

# GeoIP (MaxMind)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION_IDS=GeoLite2-Country
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb

# --- Reverse proxy -----------------------------------------------------------
# Peers whose X-Forwarded-* and CF-* headers may be believed, comma separated.
# Accepts addresses and CIDR blocks; "*" trusts any peer, which is only safe
# when nothing but the proxy can reach the listener.
#
# LEAVE THIS EMPTY IF THE APP IS EXPOSED DIRECTLY. When it is empty the headers
# are ignored entirely, because a client that can set its own X-Forwarded-For
# also sets its own rate-limit identity and can defeat every limit.
#
# For the usual Cloudflare -> nginx -> redrx chain, this is nginx's address as
# redrx sees it (the compose network subnet, or 127.0.0.1 for a host install):
# TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# Set true when Cloudflare is in front. CF-Connecting-IP names the real visitor,
# which matters because nginx appends the Cloudflare edge address to
# X-Forwarded-For -- so the last hop in that header is an edge server, not your
# user. Without this (or Cloudflare's ranges added to TRUSTED_PROXIES above)
# every visitor shares a handful of rate-limit buckets.
USE_CLOUDFLARE=false
